<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title><%= selectedExamRecord ? 'Exam Roster' : 'Exit Examinations' %> - Exit Exam Tracker</title>
	<link rel="stylesheet" href="/css/variables.css">
	<link rel="stylesheet" href="/css/courses.css">
	<link rel="stylesheet" href="/css/forms.css">
</head>
<body>
	<%- include('menuBar') %>
	<main class="main-wrapper">
		<% if (selectedExamRecord) { %>
			<section class="roster-view" aria-labelledby="roster-title">
				<a class="back-link" href="/courses<%= listQueryString ? `?${listQueryString}` : '' %>">
					<span aria-hidden="true">&larr;</span> Back to examinations
				</a>

				<header class="page-header roster-header">
					<div>
						<p class="eyebrow">Exam roster</p>
						<h1 id="roster-title" class="page-title"><%= selectedExamRecord.course.courseCode %></h1>
						<p class="page-description"><%= selectedExamRecord.course.courseName %></p>
					</div>
					<div class="exam-summary" aria-label="Exam details">
						<span><strong>Section</strong> <%= selectedExamRecord.course.section %></span>
						<span><strong>Term</strong> <%= selectedExamRecord.term %></span>
						<span><strong>School year</strong> <%= selectedExamRecord.schoolYear %></span>
						<span><strong>Students</strong> <%= selectedExamRecord.roster.length %></span>
					</div>
				</header>
				<div class="roster-actions">
					<div class="bulk-status-actions" id="rosterBulkStatusActions" hidden>
						<select id="rosterBulkStatus" aria-label="Bulk status">
							<option value="">Set status...</option>
							<option value="P">Passed</option>
							<option value="C">Completion</option>
						</select>
						<button class="button button-primary" type="button" id="applyRosterBulkStatus">Apply</button>
					</div>
					<button class="button button-primary" type="button" id="editRosterButton" data-exam-record-id="<%= selectedExamRecord._id %>">Edit Roster</button>
				</div>

				<div class="table-shell">
					<table class="exam-table roster-table">
						<thead>
							<tr>
								<th scope="col"><input type="checkbox" id="selectAllRosterStudents" aria-label="Select all students"></th>
								<th scope="col">Student Number</th>
								<th scope="col">Last Name</th>
								<th scope="col">First Name/M.I.</th>
								<th scope="col">Program</th>
								<th scope="col">Status</th>
								<th scope="col"><span class="visually-hidden">Student information</span></th>
								<th scope="col" aria-label="Actions"></th>
							</tr>
						</thead>
						<tbody>
							<% if (selectedExamRecord.roster.length === 0) { %>
								<tr><td class="empty-cell" colspan="8">No students are assigned to this exam record.</td></tr>
							<% } %>
							<% selectedExamRecord.roster.forEach((entry) => { %>
								<% if (entry.student) { %>
									<tr class="student-roster-row" data-student-id="<%= entry.student._id %>" data-exam-record-id="<%= selectedExamRecord._id %>" data-student-number="<%= entry.student.studentId %>" data-first-name="<%= entry.student.firstName %>" data-middle-name="<%= entry.student.middleName || '' %>" data-surname="<%= entry.student.surname %>" data-program="<%= entry.student.program %>">
										<td><input type="checkbox" class="roster-student-select" value="<%= entry.student._id %>" aria-label="Select <%= entry.student.studentId %>"></td>
										<td><%= entry.student.studentId %></td>
										<td><%= entry.student.surname %></td>
										<td class="student-name-cell"><%= entry.student.firstName %><%= entry.student.middleName ? ` ${entry.student.middleName.charAt(0)}.` : '' %></td>
										<td><%= entry.student.program %></td>
										<td><button class="status-badge <%= entry.status === 'P' || entry.status === 'Passed' ? 'passed' : 'completion' %> roster-status-trigger" type="button" data-value="<%= entry.status === 'P' || entry.status === 'Passed' ? 'P' : 'C' %>" aria-label="Change status for <%= entry.student.studentId %>"><%= entry.status === 'P' || entry.status === 'Passed' ? 'P' : 'C' %></button></td>
										<td class="action-cell info-action-cell"><button class="view-student-info" type="button">View student info</button></td>
										<td class="action-cell">
											<button class="icon-button delete-roster-student" type="button" data-exam-record-id="<%= selectedExamRecord._id %>" data-student-id="<%= entry.student._id %>" aria-label="Remove <%= entry.student.studentId %>" title="Remove student">&times;</button>
										</td>
									</tr>
								<% } %>
							<% }) %>
						</tbody>
					</table>
				</div>
				<div id="studentInfoModal" class="course-modal" aria-hidden="true" hidden>
					<div class="course-modal-card student-info-card" role="dialog" aria-modal="true" aria-labelledby="studentInfoTitle">
						<div class="modal-header-row"><h2 id="studentInfoTitle">Student Information</h2><button class="icon-button close-student-info" type="button" aria-label="Close">&times;</button></div>
						<dl class="student-info-list"><div><dt>Student ID</dt><dd id="infoStudentNumber"></dd></div><div><dt>First Name</dt><dd id="infoFirstName"></dd></div><div><dt>Middle Name</dt><dd id="infoMiddleName"></dd></div><div><dt>Last Name</dt><dd id="infoSurname"></dd></div><div><dt>Program</dt><dd id="infoProgram"></dd></div></dl>
					</div>
				</div>

				<div id="rosterAddStudentModal" class="course-modal" aria-hidden="true" hidden>
					<div class="course-modal-card student-form-card" role="dialog" aria-modal="true" aria-labelledby="rosterAddStudentTitle">
						
						<div class="modal-header-row">
							<h2 id="rosterAddStudentTitle">Add Students</h2>
							<button class="icon-button close-roster-add" type="button" aria-label="Close">&times;</button>
						</div>
						<form id="rosterAddStudentForm">
							<div class="form-grid">
								<label class="field">First Name<input name="firstName" required></label>
								<label class="field">Student ID Number<input name="studentId" type="text" inputmode="text" pattern="[A-Za-z0-9-]{1,20}" maxlength="20" required></label>
								<label class="field">Last Name<input name="surname" required></label>
								<label class="field">Program<select name="program" required>
									<option value="">Select program...</option>
									<option>AR</option>
									<option>CE</option>
									<option>CHE</option>
									<option>CPE</option>
									<option>EE</option>
									<option>ECE</option>
									<option>IE</option>
									<option>ME</option>
								</select></label>
								<label class="field">Middle Name<input name="middleName"></label>
							</div>
							<div class="student-import-actions roster-upload-row">
								<strong>Students</strong>
								<button type="button" class="file-upload-trigger" id="rosterAddStudentButton">+ Add students</button>
								<label class="file-upload-trigger" for="rosterStudentFile">Upload CSV or Excel file</label>
								<input id="rosterStudentFile" type="file" accept=".csv,.xls,.xlsx,.xlsm" hidden>
							</div>
							<div class="roster-staged-preview staged-roster-shell">
								<table class="exam-table staged-roster-table">
									<thead>
										<tr><th>First Name</th><th>Last Name</th><th>Student ID</th><th>Program</th><th></th></tr>
									</thead>
									<tbody id="rosterStagedBody"><tr><td class="empty-cell" colspan="5">No students added yet.</td></tr></tbody>
								</table>
							</div>
							<p id="rosterStagedCount" class="staged-count"></p>
							<p id="rosterAddMessage" class="form-message" role="alert"></p>
							<div class="modal-actions">
								<button class="button button-secondary close-roster-add" type="button">Cancel</button>
								<button class="button button-primary" type="submit">Add to Roster</button>
							</div>
						</form>
					</div>
				</div>

				<div id="rosterUpdateModal" class="course-modal" aria-hidden="true" hidden>
					<div class="roster-update-card" role="dialog" aria-modal="true" aria-labelledby="rosterUpdateTitle">
						<h2 id="rosterUpdateTitle" class="modal-title">Update Status</h2>
						<p id="rosterUpdateMessage" class="modal-message"></p>
						<div id="rosterUpdateOptions" class="status-options"></div>
						<div class="modal-actions"><button class="button button-secondary close-roster-update" type="button">Cancel</button><button class="button button-primary" id="saveRosterUpdate" type="button">Save</button></div>
					</div>
				</div>
			</section>
		<% } else { %>
			<header class="page-header">
				<div>
					<p class="eyebrow">Exam management</p>
					<h1 class="page-title">Exit Examinations</h1>
					<p class="page-description">Find an exam offering and open its assigned student roster.</p>
				</div>
				<button class="button button-primary" type="button" id="createCourseButton">Create Course</button>
			</header>
			<form class="filter-toolbar" method="get" action="/courses" role="search">
				<div class="field search-field">
					<label for="search">Search</label>
					<input id="search" name="search" type="search" value="<%= filters.search %>" placeholder="Course code, name, section, or student" maxlength="100">
				</div>
				<div class="field">
					<label for="term">Term</label>
					<select id="term" name="term">
						<option value="">All terms</option>
						<% terms.forEach((term) => { %>
							<option value="<%= term %>" <%= filters.term === term ? 'selected' : '' %>><%= term %></option>
						<% }) %>
					</select>
				</div>
				<div class="field">
					<label for="schoolYear">School Year</label>
					<select id="schoolYear" name="schoolYear">
						<option value="">All school years</option>
						<% schoolYears.forEach((schoolYear) => { %>
							<option value="<%= schoolYear %>" <%= filters.schoolYear === schoolYear ? 'selected' : '' %>><%= schoolYear %></option>
						<% }) %>
					</select>
				</div>
				<button class="button button-primary" type="submit">Apply</button>
				<a class="button button-secondary" href="/courses">Clear filters</a>
			</form>

			<div class="results-heading" aria-live="polite">
				<p><strong><%= resultCount %></strong> matching exam <%= resultCount === 1 ? 'record' : 'records' %></p>
			</div>

			<div class="table-shell">
				<table class="exam-table">
					<thead>
						<tr>
							<th scope="col">Course Code</th>
							<th scope="col">Course Name</th>
							<th scope="col">Section</th>
							<th scope="col">Term</th>
							<th scope="col">School Year</th>
							<th scope="col">Students</th>
							<th scope="col"><span class="visually-hidden">Action</span></th>
						</tr>
					</thead>
					<tbody>
						<% if (examRecords.length === 0) { %>
							<tr>
								<td class="empty-cell" colspan="7">
									<strong>No matching examinations found.</strong>
									<span>Try changing your search or clearing the filters.</span>
								</td>
							</tr>
						<% } %>
						<% examRecords.forEach((record) => { %>
							<% if (record.course) { %>
								<tr>
									<td class="course-code"><%= record.course.courseCode %></td>
									<td class="course-name-cell"><span><%= record.course.courseName %></span><button type="button" class="icon-button edit-course-name" data-course-id="<%= record.course._id %>" data-course-name="<%= record.course.courseName %>" aria-label="Edit <%= record.course.courseName %>" title="Edit course name">&#9998;</button></td>
									<td><%= record.course.section %></td>
									<td><%= record.term %></td>
									<td><%= record.schoolYear %></td>
									<td><%= record.roster.length %></td>
									<td class="action-cell">
										<a class="roster-link" href="/courses/<%= record._id %>/roster<%= listQueryString ? `?${listQueryString}` : '' %>">View Roster</a>
									</td>
								</tr>
							<% } %>
						<% }) %>
					</tbody>
				</table>
			</div>
		<% } %>
	</main>

	<% if (!selectedExamRecord) { %>
		<div id="createCourseModal" class="course-modal" aria-hidden="true" hidden>
			<div class="course-modal-card" role="dialog" aria-modal="true" aria-labelledby="createCourseTitle">
				<div class="modal-header-row">
					<div>
						<p class="eyebrow">New exam offering</p>
						<h2 id="createCourseTitle">Create Course</h2>
					</div>
					<button class="icon-button close-course-modal" type="button" aria-label="Close">&times;</button>
				</div>
				<form id="createCourseForm">
					<div class="form-grid form-grid-wide">
						<label class="field field-full">Course Name<input name="courseName" required></label>
						<label class="field">Course Code<input name="courseCode" required></label>
						<label class="field">Section<input name="section" required></label>
						<label class="field">Academic Year<select name="schoolYear" id="createCourseSchoolYear" required><option value="">Select school year...</option></select></label>
						<label class="field">Term<select name="term" required><option value="">Select term...</option><% (allTerms || terms).forEach((term) => { %><option value="<%= term %>"><%= term %></option><% }) %></select></label>
					</div>
					<div class="roster-preview-header">
						<strong>Students</strong>
						<button class="text-action" id="openAddStudentButton" type="button">+ Add Students</button>
						<label class="text-action" for="courseStudentFile">Upload CSV/Excel</label>
						<input id="courseStudentFile" type="file" accept=".csv,.xls,.xlsx,.xlsm" hidden>
					</div>
					<div class="staged-roster-shell">
						<table class="exam-table staged-roster-table"><thead><tr><th>First Name</th><th>Last Name</th><th>Student ID</th><th>Program</th><th></th></tr></thead><tbody id="stagedRosterBody"><tr id="stagedRosterEmpty"><td class="empty-cell" colspan="5">No students added yet.</td></tr></tbody></table>
					</div>
					<p id="courseFormMessage" class="form-message" role="alert"></p>
					<div class="modal-actions"><button class="button button-secondary close-course-modal" type="button">Cancel</button><button class="button button-primary" type="submit">Save</button></div>
				</form>
			</div>
		</div>

		<div id="addStudentModal" class="course-modal" aria-hidden="true" hidden>
			<div class="course-modal-card student-form-card" role="dialog" aria-modal="true" aria-labelledby="addStudentTitle">
				<div class="modal-header-row"><h2 id="addStudentTitle">Add Students</h2><button class="icon-button close-student-modal" type="button" aria-label="Close">&times;</button></div>
				<form id="addStudentForm">
					<div class="form-grid"><label class="field">First Name<input name="firstName" required></label><label class="field">Student ID Number<input name="studentId" type="text" inputmode="text" pattern="[A-Za-z0-9-]{1,20}" maxlength="20" required></label><label class="field">Last Name<input name="surname" required></label><label class="field">Program<select name="program" required><option value="">Select program...</option><option>AR</option><option>CE</option><option>CHE</option><option>CPE</option><option>EE</option><option>ECE</option><option>IE</option><option>ME</option></select></label><label class="field">Middle Name<input name="middleName"></label></div>
					<p id="studentFormMessage" class="form-message" role="alert"></p>
					<div class="modal-actions"><button class="button button-secondary close-student-modal" type="button">Cancel</button><button class="button button-primary" type="submit">Add to List</button></div>
				</form>
			</div>
		</div>
	<% } %>
	<script src="/scripts/courses.js"></script>
</body>
</html>
