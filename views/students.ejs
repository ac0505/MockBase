<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Students - Exit Exam Tracker</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Albert+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,400,0,0" rel="stylesheet">
    <link rel="stylesheet" href="/css/variables.css">
    <link rel="stylesheet" href="/css/students.css">
</head>
<body>
    <%- include('menuBar') %>
    <% const studentRows = Array.isArray(locals.students) ? locals.students : []; %>

    <main class="main-wrapper">
        <div class="page-header">
            <h1 class="page-title">Students</h1>
        </div>

        <div class="controls-row">
            <div class="search-and-add">
                <!-- Search -->
                <div class="search-container">
                    <input 
                        type="text" 
                        id="studentSearch" 
                        class="search-input" 
                        placeholder="Search by surname, first name, or student ID..." 
                        autocomplete="off"
                        aria-label="Search students"
                    >
                </div>

                <!-- Add Students -->
                <button type="button" class="btn-add-student" id="addStudentBtn">
                    Add Students
                </button>
            </div>
            

            <!-- Filter -->
            <div class="search-filter-wrapper">
                <button type="button" class="filter-btn" id="filterBtn" onclick="toggleFilterDropdown(event)">
                    <span class="material-symbols-outlined" style="font-size: 18px; margin-right: 6px;">filter_list</span>
                    Filter
                    <span id="filterActiveBadge" class="filter-active-badge" style="display: none;"></span>
                </button>

                <!-- Filter Dropdown Popover -->
                <div id="filterDropdown" class="filter-dropdown" style="display: none;">
                    <div class="filter-header">
                        <span class="filter-title">Filter Students</span>
                        <button type="button" id="btnCloseFilter" class="filter-close-btn" aria-label="Close filter">&times;</button>
                    </div>

                    <div class="filter-group">
                        <label for="filterProgram" class="filter-label">Program</label>
                        <select id="filterProgram" class="filter-select">
                            <option value="ALL">All Programs</option>
                            <option value="AR">AR</option>
                            <option value="CE">CE</option>
                            <option value="CHE">CHE</option>
                            <option value="CPE">CPE</option>
                            <option value="EE">EE</option>
                            <option value="ECE">ECE</option>
                            <option value="IE">IE</option>
                            <option value="ME">ME</option>
                        </select>
                    </div>

                    <div class="filter-group">
                        <label for="filterCourse" class="filter-label">Course Code</label>
                        <select id="filterCourse" class="filter-select">
                            <option value="ALL">All Course Codes</option>
                        </select>
                    </div>

                    <div class="filter-group">
                        <label for="filterSection" class="filter-label">Section</label>
                        <select id="filterSection" class="filter-select">
                            <option value="ALL">All Sections</option>
                        </select>
                    </div>

                    <div class="filter-footer">
                        <button type="button" id="btnResetFilter" class="btn-filter-reset">Reset</button>
                        <button type="button" id="btnApplyFilter" class="btn-filter-apply">Apply</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="table-container">
            <table class="students-table" id="studentsTable">
                <thead>
                    <tr>
                        <th>Surname</th>
                        <th>First name/M.I.</th>
                        <th>Student ID</th>
                        <th>Course Code</th>
                        <th>Program</th>
                        <th>Section</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody id="tableBody">
                    <% studentRows.forEach(function(row) { %>
                    <tr
                        data-surname="<%= row.surname %>"
                        data-firstname="<%= row.firstNameDisplay %>"
                        data-studentid="<%= row.studentId %>"
                        data-course="<%= row.courseCode %>"
                        data-program="<%= row.program %>"
                        data-section="<%= row.section %>"
                        data-examrecordid="<%= row.examRecordId %>"
                        data-studentobjectid="<%= row.studentObjectId %>"
                    >
                        <td><%= row.surname %></td>
                        <td><%= row.firstNameDisplay %></td>
                        <td><%= row.studentId %></td>
                        <td><%= row.courseCode %></td>
                        <td><%= row.program %></td>
                        <td><%= row.section %></td>
                        <td><span class="status-badge <%= row.statusClass %>" title="Click to update status"><%= row.statusLabel %></span></td>
                    </tr>
                    <% }); %>
                    <tr id="noResultsRow" class="no-results-row" style="display: <%= studentRows.length === 0 ? '' : 'none' %>">
                        <td colspan="7" class="no-results-cell">
                            No matching student records found.
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </main>

    <!-- Update Status Popup Modal -->
    <div id="statusModal" class="modal-backdrop" aria-hidden="true" style="display: none;">
        <div class="modal-card" role="dialog" aria-labelledby="modalTitle">
            <!-- Step 1: Confirmation Prompt -->
            <div id="modalStepConfirm" class="modal-step">
                <h2 id="modalTitle" class="modal-title">Update Status</h2>
                <p class="modal-message">Do you want to update status for <strong id="studentNameText">Student</strong>?</p>
                <div class="modal-actions">
                    <button type="button" class="btn btn-secondary" id="btnConfirmNo">No</button>
                    <button type="button" class="btn btn-primary" id="btnConfirmYes">Yes</button>
                </div>
            </div>

            <!-- Step 2: Select Status & Save -->
            <div id="modalStepSelect" class="modal-step" style="display: none;">
                <h2 class="modal-title">Select Status</h2>
                <p class="modal-subtext">Choose new status for <strong id="studentNameSelectText">Student</strong>:</p>
                
                <div class="status-options">
                    <label class="status-option-card" for="optPassed">
                        <input type="radio" name="statusOption" id="optPassed" value="P">
                        <span class="status-badge passed">P</span>
                        <span class="option-label">Passed</span>
                    </label>
                    
                    <label class="status-option-card" for="optCompletion">
                        <input type="radio" name="statusOption" id="optCompletion" value="C">
                        <span class="status-badge completion">C</span>
                        <span class="option-label">Completion</span>
                    </label>
                </div>

                <div class="modal-actions">
                    <button type="button" class="btn btn-secondary" id="btnCancelSelect">Cancel</button>
                    <button type="button" class="btn btn-primary" id="btnSaveStatus">Save</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Add Students Modal -->
    <div id="addStudentsModal" class="modal-backdrop" aria-hidden="true" style="display: none;">
        <div class="modal-card add-students-card" role="dialog" aria-labelledby="addStudentsTitle">
            <div class="modal-header-row">
                <h2 id="addStudentsTitle" class="modal-title">Add Students</h2>
                <button type="button" class="filter-close-btn" id="btnCloseAddStudents" aria-label="Close">&times;</button>
            </div>

            <div class="add-students-body">
                <div class="form-row">
                    <div class="form-group">
                        <label for="asCourseSelect" class="filter-label">Course</label>
                        <select id="asCourseSelect" class="filter-select">
                            <option value="">Select a course...</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="asTermSelect" class="filter-label">Term</label>
                        <select id="asTermSelect" class="filter-select">
                            <option value="">Select term...</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="asSchoolYear" class="filter-label">School Year</label>
                        <input type="text" id="asSchoolYear" class="filter-select" placeholder="2025-2026">
                    </div>
                </div>

                <hr class="add-students-divider">

                <div class="form-group">
                    <label for="asStudentSearch" class="filter-label">Add a student</label>
                    <div class="as-search-wrapper">
                        <input type="text" id="asStudentSearch" class="search-input" placeholder="Search by name or student ID..." autocomplete="off">
                        <div id="asSearchResults" class="as-search-results" style="display: none;"></div>
                    </div>
                    <button type="button" id="asShowNewStudentForm" class="btn-filter-reset" style="margin-top: 8px;">+ Add new student instead</button>
                </div>

                <div id="asNewStudentForm" class="as-new-student-form" style="display: none;">
                    <div class="form-row">
                        <div class="form-group">
                            <label for="asNewStudentId" class="filter-label">Student ID</label>
                            <input type="text" id="asNewStudentId" class="filter-select">
                        </div>
                        <div class="form-group">
                            <label for="asNewProgram" class="filter-label">Program</label>
                            <select id="asNewProgram" class="filter-select">
                                <option value="AR">AR</option>
                                <option value="CE">CE</option>
                                <option value="CHE">CHE</option>
                                <option value="CPE">CPE</option>
                                <option value="EE">EE</option>
                                <option value="ECE">ECE</option>
                                <option value="IE">IE</option>
                                <option value="ME">ME</option>
                            </select>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label for="asNewSurname" class="filter-label">Surname</label>
                            <input type="text" id="asNewSurname" class="filter-select">
                        </div>
                        <div class="form-group">
                            <label for="asNewFirstName" class="filter-label">First Name</label>
                            <input type="text" id="asNewFirstName" class="filter-select">
                        </div>
                        <div class="form-group">
                            <label for="asNewMiddleName" class="filter-label">Middle Name</label>
                            <input type="text" id="asNewMiddleName" class="filter-select">
                        </div>
                    </div>
                    <div class="modal-actions" style="justify-content: flex-start; margin-top: 8px;">
                        <button type="button" id="asAddNewStudentBtn" class="btn btn-primary" style="height: 36px; padding: 0 16px; font-size: 13px;">Add to list</button>
                        <button type="button" id="asCancelNewStudentBtn" class="btn btn-secondary" style="height: 36px; padding: 0 16px; font-size: 13px;">Cancel</button>
                    </div>
                </div>

                <div class="as-selected-list" id="asSelectedList">
                    <p class="as-empty-hint">No students added yet.</p>
                </div>
            </div>

            <div class="modal-actions">
                <button type="button" class="btn btn-secondary" id="btnCancelAddStudents">Cancel</button>
                <button type="button" class="btn btn-primary" id="btnSubmitAddStudents">Add Students</button>
            </div>
        </div>
    </div>

    <script src="/scripts/students.js"></script>
</body>
</html>
