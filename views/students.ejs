                </tbody>
            </table>
        </div>
    </main>

    <!-- Update Status Popup Modal -->
    <div id="statusModal" class="modal-backdrop" aria-hidden="true" style="display: none;">
        <div class="modal-card" role="dialog" aria-labelledby="modalTitle">
            <!-- Step 1: Confirmation Prompt -->
            <div id="modalStepConfirm" class="modal-step">
                <h2 id="modalTitle" class="modal-title">Update Status</h2>
                <p class="modal-message">Do you want to update status for <strong id="studentNameText">Student</strong>?</p>
                <div class="modal-actions">
                    <button type="button" class="btn btn-secondary" id="btnConfirmNo">No</button>
                    <button type="button" class="btn btn-primary" id="btnConfirmYes">Yes</button>
                </div>
            </div>

            <!-- Step 2: Select Status & Save -->
            <div id="modalStepSelect" class="modal-step" style="display: none;">
                <h2 class="modal-title">Select Status</h2>
                <p class="modal-subtext">Choose new status for <strong id="studentNameSelectText">Student</strong>:</p>
                
                <div class="status-options">
                    <label class="status-option-card" for="optPassed">
                        <input type="radio" name="statusOption" id="optPassed" value="P">
                        <span class="status-badge passed">P</span>
                        <span class="option-label">Passed</span>
                    </label>
                    
                    <label class="status-option-card" for="optCompletion">
                        <input type="radio" name="statusOption" id="optCompletion" value="C">
                        <span class="status-badge completion">C</span>
                        <span class="option-label">Completion</span>
                    </label>
                </div>

                <div class="modal-actions">
                    <button type="button" class="btn btn-secondary" id="btnCancelSelect">Cancel</button>
                    <button type="button" class="btn btn-primary" id="btnSaveStatus">Save</button>
                </div>
            </div>
        </div>
    </div>

    <script src="/scripts/students.js"></script>
</body>
</html>