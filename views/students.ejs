<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Students - Exit Exam Tracker</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Albert+Sans:wght@400;500;600;700;800&display=swap"
        rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,400,0,0"
        rel="stylesheet">
    <link rel="stylesheet" href="/css/variables.css">
    <link rel="stylesheet" href="/css/students.css">
    <link rel="stylesheet" href="/css/forms.css">
</head>

<body>
    <%- include('menuBar') %>
        <% const studentRows=Array.isArray(locals.students) ? locals.students : []; %>

            <main class="main-wrapper">
                <header class="page-header students-page-header">
                    <div>
                        <p class="eyebrow">Student records</p>
                        <h1 class="page-title">Students</h1>
                        <p class="page-description">Search, filter, and update exit-exam status for enrolled students.</p>
                    </div>
                    <button type="button" class="btn-add-student" id="addStudentBtn">
                        <span aria-hidden="true">+</span> Add Students
                    </button>
                </header>

                <div class="controls-row">
                    <div class="search-and-add">
                        <!-- Search -->
                        <div class="search-container">
                            <input type="text" id="studentSearch" class="search-input"
                                placeholder="Search by last name, first name, or student ID..." autocomplete="off"
                                aria-label="Search students">
                        </div>

                    </div>


                    <!-- Filter -->
                    <div class="search-filter-wrapper">
                        <button type="button" class="filter-btn" id="filterBtn" aria-expanded="false">
                            <span class="material-symbols-outlined"
                                style="font-size: 18px; margin-right: 6px;">filter_list</span>
                            Filter
                            <span id="filterActiveBadge" class="filter-active-badge" style="display: none;"></span>
                        </button>

                        <!-- Filter Dropdown Popover -->
                        <div id="filterDropdown" class="filter-dropdown">
                            <div class="filter-header">
                                <span class="filter-title">Filter Students</span>
                                <button type="button" id="btnCloseFilter" class="filter-close-btn"
                                    aria-label="Close filter">&times;</button>
                            </div>

                            <div class="filter-group">
                                <label for="filterProgram" class="filter-label">Program</label>
                                <select id="filterProgram" class="filter-select">
                                    <option value="ALL">All Programs</option>
                                    <option value="AR">AR</option>
                                    <option value="CE">CE</option>
                                    <option value="CHE">CHE</option>
                                    <option value="CPE">CPE</option>
                                    <option value="EE">EE</option>
                                    <option value="ECE">ECE</option>
                                    <option value="IE">IE</option>
                                    <option value="ME">ME</option>
                                </select>
                            </div>

                            <div class="filter-group">
                                <label for="filterCourse" class="filter-label">Course Code</label>
                                <select id="filterCourse" class="filter-select">
                                    <option value="ALL">All Course Codes</option>
                                </select>
                            </div>

                            <div class="filter-group">
                                <label for="filterSection" class="filter-label">Section</label>
                                <select id="filterSection" class="filter-select">
                                    <option value="ALL">All Sections</option>
                                </select>
                            </div>

                            <div class="filter-footer">
                                <button type="button" id="btnResetFilter" class="btn-filter-reset">Reset</button>
                                <button type="button" id="btnApplyFilter" class="btn-filter-apply">Apply</button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="records-summary">
                    <p><strong><%= studentRows.length %></strong> records</p>
                    <div class="status-legend" aria-label="Student status legend">
                        <span><b class="legend-badge passed">P</b> Passed</span>
                        <span><b class="legend-badge completion">C</b> Completion</span>
                    </div>
                </div>

                <div class="table-container">
                    <table class="students-table" id="studentsTable">
                        <thead>
                            <tr>
                                <th>Last Name</th>
                                <th>First name/M.I.</th>
                                <th>Student ID</th>
                                <th>Course Code</th>
                                <th>Program</th>
                                <th>Section</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody id="tableBody">
                            <% studentRows.forEach(function(row) { %>
                                <tr data-surname="<%= row.surname %>" data-firstname="<%= row.firstNameDisplay %>"
                                    data-studentid="<%= row.studentId %>" data-course="<%= row.courseCode %>"
                                    data-program="<%= row.program %>" data-section="<%= row.section %>"
                                    data-examrecordid="<%= row.examRecordId %>"
                                    data-studentobjectid="<%= row.studentObjectId %>">
                                    <td>
                                        <%= row.surname %>
                                    </td>
                                    <td>
                                        <%= row.firstNameDisplay %>
                                    </td>
                                    <td>
                                        <%= row.studentId %>
                                    </td>
                                    <td>
                                        <%= row.courseCode %>
                                    </td>
                                    <td>
                                        <%= row.program %>
                                    </td>
                                    <td>
                                        <%= row.section %>
                                    </td>
                                    <td><span class="status-badge <%= row.statusClass %>"
                                            title="Click to update status">
                                            <%= row.statusLabel %>
                                        </span></td>
                                </tr>
                                <% }); %>
                                    <tr id="noResultsRow" class="no-results-row <%= studentRows.length === 0 ? '' : 'is-hidden' %>">
                                        <td colspan="7" class="no-results-cell">
                                            No matching student records found.
                                        </td>
                                    </tr>
                        </tbody>
                    </table>
                </div>
            </main>

            <!-- Update Status Popup Modal -->
            <div id="statusModal" class="modal-backdrop" aria-hidden="true" style="display: none;">
                <div class="modal-card" role="dialog" aria-labelledby="modalTitle">
                    <!-- Step 1: Confirmation Prompt -->
                    <div id="modalStepConfirm" class="modal-step">
                        <h2 id="modalTitle" class="modal-title">Update Status</h2>
                        <p class="modal-message">Do you want to update status for <strong
                                id="studentNameText">Student</strong>?</p>
                        <div class="modal-actions">
                            <button type="button" class="btn btn-secondary" id="btnConfirmNo">No</button>
                            <button type="button" class="btn btn-primary" id="btnConfirmYes">Yes</button>
                        </div>
                    </div>

                    <!-- Step 2: Select Status & Save -->
                    <div id="modalStepSelect" class="modal-step" style="display: none;">
                        <h2 class="modal-title">Select Status</h2>
                        <p class="modal-subtext">Choose new status for <strong
                                id="studentNameSelectText">Student</strong>:</p>

                        <div class="status-options">
                            <label class="status-option-card" for="optPassed">
                                <input type="radio" name="statusOption" id="optPassed" value="P">
                                <span class="status-badge passed">P</span>
                                <span class="option-label">Passed</span>
                            </label>

                            <label class="status-option-card" for="optCompletion">
                                <input type="radio" name="statusOption" id="optCompletion" value="C">
                                <span class="status-badge completion">C</span>
                                <span class="option-label">Completion</span>
                            </label>
                        </div>

                        <div class="modal-actions">
                            <button type="button" class="btn btn-secondary" id="btnCancelSelect">Cancel</button>
                            <button type="button" class="btn btn-primary" id="btnSaveStatus">Save</button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Add Students Modal -->
            <div id="addStudentsModal" class="course-modal" aria-hidden="true" style="display: none;">
                <div class="course-modal-card add-students-card" role="dialog" aria-modal="true"
                    aria-labelledby="addStudentsTitle">
                    <div class="modal-header-row">
                            <div>
                                <h2 id="addStudentsTitle">Add Students</h2>
                                <p class="modal-subtitle">Pick an exam offering, then search and select students to add to its roster.</p>
                            </div>
                            <button class="icon-button" id="btnCloseAddStudents" type="button" aria-label="Close">&times;</button>
                    </div>

                            <div class="add-students-body">
                            <div class="add-student-offering-grid">
                                <div class="form-group course-offering-field">
                                    <label for="asSchoolYear" class="filter-label">Academic Year</label>
                                    <select id="asSchoolYear" class="filter-select"><option value="">Select academic year...</option></select>
                                </div>
                                <div class="form-group course-offering-field">
                                    <label for="asTerm" class="filter-label">Term</label>
                                    <select id="asTerm" class="filter-select" disabled><option value="">Select term...</option></select>
                                </div>
                                <div class="form-group course-offering-field">
                                    <label for="asCourseCode" class="filter-label">Course Code</label>
                                    <select id="asCourseCode" class="filter-select" disabled><option value="">Select course code...</option></select>
                                </div>
                                <div class="form-group course-offering-field">
                                    <label for="asSection" class="filter-label">Section</label>
                                    <select id="asSection" class="filter-select" disabled><option value="">Select section...</option></select>
                                </div>
                            </div>

                            <div id="studentSelectionPanel" class="student-selection-panel" hidden>
                                <hr class="add-students-divider">
                                <div class="form-group">
                                    <label for="asStudentSearch" class="filter-label">Add a student</label>
                                    <div class="as-search-wrapper">
                                        <input type="text" id="asStudentSearch" class="search-input"
                                            placeholder="Search by name or student ID..." autocomplete="off">
                                        <div id="asSearchResults" class="as-search-results" style="display: none;"></div>
                                    </div>
                                    <div class="student-import-actions">
                                        <strong>Students</strong>
                                        <button type="button" id="asShowNewStudentForm" class="btn-filter-reset">+ Add students</button>
                                        <label for="asStudentFile" class="btn-filter-reset">Upload CSV or Excel file</label>
                                        <input type="file" id="asStudentFile" accept=".csv,.xls,.xlsx,.xlsm" hidden>
                                    </div>
                                </div>

                                <div class="as-selected-list staged-roster-shell" id="asSelectedList">
                                    <table class="exam-table staged-roster-table">
                                        <thead>
                                            <tr>
                                                <th>First Name</th>
                                                <th>Last Name</th>
                                                <th>Student ID</th>
                                                <th>Program</th>
                                                <th></th>
                                            </tr>
                                        </thead>
                                        <tbody id="asSelectedTableBody"><tr><td class="empty-cell" colspan="5">No students added yet.</td></tr></tbody>
                                    </table>
                                </div>
                                <p id="asSelectedCount" class="staged-count"></p>
                            </div>
                        </div>

                        <div class="modal-actions">
                        <button class="button button-secondary" type="button" id="btnCancelAddStudents">Cancel</button>
                        <button class="button button-primary" type="button" id="btnSubmitAddStudents" disabled>Add
                            Students</button>
                    </div>
                    </div>

                    
                </div>
            </div>

            <div id="newStudentModal" class="course-modal" aria-hidden="true" style="display: none;">
                <div class="course-modal-card student-form-card" role="dialog" aria-modal="true"
                    aria-labelledby="newStudentTitle">
                    <div class="modal-header-row">
                        <h2 id="newStudentTitle">Add New Student</h2>
                        <button class="icon-button" id="btnCloseNewStudent" type="button"
                            aria-label="Close">&times;</button>
                    </div>
                    <form id="newStudentForm">
                        <div class="form-grid">
                            <label class="field">Last Name<input id="asNewSurname" type="text" required></label>
                            <label class="field">First Name/M.I.<input id="asNewFirstName" type="text" required></label>
                            <label class="field">Middle Name<input id="asNewMiddleName" type="text"></label>
                            <label class="field">Student ID Number<input id="asNewStudentId" type="text"
                                    inputmode="text" pattern="[A-Za-z0-9-]{1,20}" maxlength="20" required></label>
                            <label class="field">Program<select id="asNewProgram" required>
                                    <option value="">Select program...</option>
                                    <option value="AR">AR</option>
                                    <option value="CE">CE</option>
                                    <option value="CHE">CHE</option>
                                    <option value="CPE">CPE</option>
                                    <option value="EE">EE</option>
                                    <option value="ECE">ECE</option>
                                    <option value="IE">IE</option>
                                    <option value="ME">ME</option>
                                </select></label>
                            <label class="field">School Year<select id="asNewSchoolYear" required><option value="">Select school year...</option></select></label>
                            <label class="field">Term<select id="asNewTerm" required disabled><option value="">Select term...</option></select></label>
                            <label class="field">Course Code<select id="asNewCourse" required disabled><option value="">Select course...</option></select></label>
                            <label class="field">Section<select id="asNewSection" required disabled><option value="">Select section...</option></select></label>
                        </div>
                        <div class="modal-actions">
                            <button class="button button-secondary" id="asCancelNewStudentBtn"
                                type="button">Cancel</button>
                            <button class="button button-primary" id="asAddNewStudentBtn" type="submit">Add to
                                List</button>
                        </div>
                    </form>
                </div>
            </div>

            <footer class="dev-copyright">
            &copy; <%= new Date().getFullYear() %> Andrea Caunga. All rights reserved.
        </footer>

            <script>
                window.studentCourseOptions = <%- JSON.stringify(locals.courseOptions || []) %>;
            </script>
            <script src="/scripts/students.js"></script>
</body>

</html>