    </main>

    <!-- Update Status Popup Modal -->
    <div id="statusModal" class="modal-backdrop" aria-hidden="true" style="display: none;">
        <div class="modal-card" role="dialog" aria-labelledby="modalTitle">
            <!-- Step 1: Confirmation Prompt -->
            <div id="modalStepConfirm" class="modal-step">
                <h2 id="modalTitle" class="modal-title">Update Status</h2>
                <p class="modal-message">Do you want to update status for <strong id="studentNameText">Student</strong>?</p>
                <div class="modal-actions">
                    <button type="button" class="btn btn-secondary" id="btnConfirmNo">No</button>
                    <button type="button" class="btn btn-primary" id="btnConfirmYes">Yes</button>
                </div>
            </div>

            <!-- Step 2: Select Status & Save -->
            <div id="modalStepSelect" class="modal-step" style="display: none;">
                <h2 class="modal-title">Select Status</h2>
                <p class="modal-subtext">Choose new status for <strong id="studentNameSelectText">Student</strong>:</p>
                
                <div class="status-options">
                    <label class="status-option-card" for="optPassed">
                        <input type="radio" name="statusOption" id="optPassed" value="P">
                        <span class="status-badge passed">P</span>
                        <span class="option-label">Passed</span>
                    </label>
                    
                    <label class="status-option-card" for="optCompletion">
                        <input type="radio" name="statusOption" id="optCompletion" value="C">
                        <span class="status-badge completion">C</span>
                        <span class="option-label">Completion</span>
                    </label>
                </div>

                <div class="modal-actions">
                    <button type="button" class="btn btn-secondary" id="btnCancelSelect">Cancel</button>
                    <button type="button" class="btn btn-primary" id="btnSaveStatus">Save</button>
                </div>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const searchInput = document.getElementById('studentSearch');
            const tableBody = document.getElementById('tableBody');
            const rows = tableBody.querySelectorAll('tr:not(.no-results-row)');
            const noResultsRow = document.getElementById('noResultsRow');

            // Sync thead width with tbody scrollbar
            const tbody = document.querySelector('.students-table tbody');
            const thead = document.querySelector('.students-table thead');
            function syncScrollbarWidth() {
                const scrollbarW = tbody.offsetWidth - tbody.clientWidth;
                thead.style.paddingRight = scrollbarW + 'px';
                thead.style.overflowY = 'hidden';
            }
            syncScrollbarWidth();
            window.addEventListener('resize', syncScrollbarWidth);

            const filterBtn = document.getElementById('filterBtn');
            const filterDropdown = document.getElementById('filterDropdown');
            const btnCloseFilter = document.getElementById('btnCloseFilter');
            const btnResetFilter = document.getElementById('btnResetFilter');
            const btnApplyFilter = document.getElementById('btnApplyFilter');
            const filterActiveBadge = document.getElementById('filterActiveBadge');

            const filterProgram = document.getElementById('filterProgram');
            const filterCourse = document.getElementById('filterCourse');
            const filterSection = document.getElementById('filterSection');

            // Populate Course Code dropdown from dataset
            function populateCourseDropdown() {
                const courses = new Set();
                rows.forEach(row => {
                    const c = (row.dataset.course || '').trim();
                    if (c) courses.add(c);
                });

                filterCourse.innerHTML = '<option value="ALL">All Course Codes</option>';
                Array.from(courses).sort().forEach(c => {
                    const opt = document.createElement('option');
                    opt.value = c;
                    opt.textContent = c;
                    filterCourse.appendChild(opt);
                });
            }

            // Update Section dropdown based ONLY on available opened sections for selected course
            function updateSectionDropdown() {
                const selectedCourse = filterCourse.value;
                const selectedProgram = filterProgram.value;

                if (selectedCourse === 'ALL') {
                    filterSection.innerHTML = '<option value="ALL">Select a course code first</option>';
                    filterSection.disabled = true;
                    filterSection.value = 'ALL';
                } else {
                    filterSection.disabled = false;
                    const currentSectionVal = filterSection.value;
                    const availableSections = new Set();

                    rows.forEach(row => {
                        const c = (row.dataset.course || '').trim().toUpperCase();
                        const p = (row.dataset.program || '').trim().toUpperCase();
                        const s = (row.dataset.section || '').trim().toUpperCase();

                        const matchesCourse = (c === selectedCourse.toUpperCase());
                        const matchesProgram = (selectedProgram === 'ALL' || p === selectedProgram.toUpperCase());

                        if (matchesCourse && matchesProgram && s) {
                            availableSections.add(s);
                        }
                    });

                    filterSection.innerHTML = '<option value="ALL">All Sections</option>';
                    Array.from(availableSections).sort().forEach(sec => {
                        const opt = document.createElement('option');
                        opt.value = sec;
                        opt.textContent = sec;
                        filterSection.appendChild(opt);
                    });

                    if (availableSections.has(currentSectionVal)) {
                        filterSection.value = currentSectionVal;
                    } else {
                        filterSection.value = 'ALL';
                    }
                }
            }

            populateCourseDropdown();
            updateSectionDropdown();

            filterCourse.addEventListener('change', updateSectionDropdown);
            filterProgram.addEventListener('change', updateSectionDropdown);

            // Combined Search & Filter Function
            function filterStudents() {
                const searchQuery = searchInput.value.trim().toLowerCase();
                const selProg = filterProgram.value;
                const selCourse = filterCourse.value;
                const selSec = filterSection.value;

                let visibleCount = 0;
                let hasActiveFilter = (selProg !== 'ALL' || selCourse !== 'ALL' || selSec !== 'ALL');

                filterActiveBadge.style.display = hasActiveFilter ? 'inline-block' : 'none';

                rows.forEach(row => {
                    const surname = (row.dataset.surname || '').toLowerCase();
                    const firstname = (row.dataset.firstname || '').toLowerCase();
                    const studentId = (row.dataset.studentid || '').toLowerCase();
                    const course = (row.dataset.course || '').trim().toUpperCase();
                    const program = (row.dataset.program || '').trim().toUpperCase();
                    const section = (row.dataset.section || '').trim().toUpperCase();

                    const fullText = row.textContent.toLowerCase();

                    const matchesSearch = !searchQuery || 
                        surname.includes(searchQuery) || 
                        firstname.includes(searchQuery) || 
                        studentId.includes(searchQuery) || 
                        fullText.includes(searchQuery);

                    const matchesProg = (selProg === 'ALL' || program === selProg.toUpperCase());
                    const matchesCourse = (selCourse === 'ALL' || course === selCourse.toUpperCase());
                    const matchesSec = (selSec === 'ALL' || section === selSec.toUpperCase());

                    if (matchesSearch && matchesProg && matchesCourse && matchesSec) {
                        row.style.display = '';
                        visibleCount++;
                    } else {
                        row.style.display = 'none';
                    }
                });

                if (visibleCount === 0) {
                    noResultsRow.style.display = '';
                } else {
                    noResultsRow.style.display = 'none';
                }
            }

            // Real-time Search
            searchInput.addEventListener('input', filterStudents);

            // Toggle Filter Dropdown
            filterBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                const isExpanded = filterDropdown.style.display === 'block';
                filterDropdown.style.display = isExpanded ? 'none' : 'block';
                filterBtn.setAttribute('aria-expanded', String(!isExpanded));
            });

            btnCloseFilter.addEventListener('click', () => {
                filterDropdown.style.display = 'none';
                filterBtn.setAttribute('aria-expanded', 'false');
            });

            btnApplyFilter.addEventListener('click', () => {
                filterStudents();
                filterDropdown.style.display = 'none';
                filterBtn.setAttribute('aria-expanded', 'false');
            });

            btnResetFilter.addEventListener('click', () => {
                filterProgram.value = 'ALL';
                filterCourse.value = 'ALL';
                updateSectionDropdown();
                filterSection.value = 'ALL';
                filterStudents();
            });

            // Close filter dropdown on outside click
            document.addEventListener('click', (e) => {
                if (!filterDropdown.contains(e.target) && e.target !== filterBtn && !filterBtn.contains(e.target)) {
                    filterDropdown.style.display = 'none';
                    filterBtn.setAttribute('aria-expanded', 'false');
                }
            });

            // Status Update Popup Modal Logic
            let currentTargetBadge = null;
            let currentStudentName = '';
            let currentStatus = 'P';

            tableBody.addEventListener('click', (e) => {
                const badge = e.target.closest('.status-badge');
                if (!badge) return;

                const row = badge.closest('tr');
                if (!row || row.classList.contains('no-results-row')) return;

                currentTargetBadge = badge;
                const surname = row.dataset.surname || '';
                const firstname = row.dataset.firstname || '';
                currentStudentName = `${firstname} ${surname}`.trim() || 'Student';
                currentStatus = badge.classList.contains('completion') ? 'C' : 'P';

                document.getElementById('studentNameText').textContent = currentStudentName;
                document.getElementById('studentNameSelectText').textContent = currentStudentName;

                document.getElementById('modalStepConfirm').style.display = 'block';
                document.getElementById('modalStepSelect').style.display = 'none';

                const modal = document.getElementById('statusModal');
                modal.style.display = 'flex';
                modal.setAttribute('aria-hidden', 'false');
            });

            document.getElementById('btnConfirmNo').addEventListener('click', closeModal);

            document.getElementById('btnConfirmYes').addEventListener('click', () => {
                if (currentStatus === 'C') {
                    document.getElementById('optCompletion').checked = true;
                } else {
                    document.getElementById('optPassed').checked = true;
                }

                document.getElementById('modalStepConfirm').style.display = 'none';
                document.getElementById('modalStepSelect').style.display = 'block';
            });

            document.getElementById('btnCancelSelect').addEventListener('click', closeModal);

            document.getElementById('btnSaveStatus').addEventListener('click', () => {
                if (!currentTargetBadge) return;

                const selectedOption = document.querySelector('input[name="statusOption"]:checked');
                if (!selectedOption) return;

                const newStatus = selectedOption.value;

                if (newStatus === 'P') {
                    currentTargetBadge.className = 'status-badge passed';
                    currentTargetBadge.textContent = 'P';
                } else {
                    currentTargetBadge.className = 'status-badge completion';
                    currentTargetBadge.textContent = 'C';
                }

                closeModal();
            });

            function closeModal() {
                const modal = document.getElementById('statusModal');
                modal.style.display = 'none';
                modal.setAttribute('aria-hidden', 'true');
                currentTargetBadge = null;
            }

            document.getElementById('statusModal').addEventListener('click', (e) => {
                if (e.target === document.getElementById('statusModal')) {
                    closeModal();
                }
            });
        });
    </script>
</body>
</html>